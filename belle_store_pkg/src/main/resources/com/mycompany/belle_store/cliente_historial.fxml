<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.belle_store.controladores.ClienteHistorialController"
            prefWidth="1360.0" prefHeight="820.0"
            stylesheets="@css/estilos.css">

    <!-- ========================================================================= -->
    <!-- CABECERA GLOBAL COMPARTIDA DE CLIENTE                                     -->
    <!-- ========================================================================= -->
    <top>
        <fx:include fx:id="header" source="cliente_header.fxml" />
    </top>

    <!-- ========================================================================= -->
    <!-- ÁREA CENTRAL: TÍTULO + TABLA DE HISTORIAL DE COMPRAS (FIGMA 86:261)       -->
    <!-- ========================================================================= -->
    <center>
        <VBox spacing="16" styleClass="fondo-blanco">
            <padding>
                <Insets top="24" right="36" bottom="24" left="36" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Historial de compras" styleClass="titulo-admin" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Seguir comprando"
                        onAction="#irAlCatalogo"
                        styleClass="boton-secundario" />
            </HBox>

            <TableView fx:id="tablaHistorial"
                       styleClass="tabla-belle"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFecha" text="FECHA" prefWidth="170" />
                    <TableColumn fx:id="colCodigo" text="CODIGO" prefWidth="120" />
                    <TableColumn fx:id="colTipo" text="TIPO" prefWidth="180" />
                    <TableColumn fx:id="colProductos" text="PRODUCTOS" prefWidth="420" />
                    <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="170" />
                    <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="160" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblContadorOrdenes" text="" styleClass="contador-registros" />
        </VBox>
    </center>
</BorderPane>
