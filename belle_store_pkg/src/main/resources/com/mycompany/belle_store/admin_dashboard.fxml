<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.belle_store.controladores.AdminDashboardController"
            prefWidth="1280.0" prefHeight="768.0"
            stylesheets="@css/estilos.css">

    <!-- ========================================================================= -->
    <!-- CABECERA GLOBAL                                                           -->
    <!-- ========================================================================= -->
    <top>
        <HBox styleClass="cabecera-global" alignment="CENTER_LEFT" spacing="20">
            <Label text="Belle store" styleClass="logo-belle" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="25">
                <Label text="Hombre" styleClass="nav-link" />
                <Label text="Mujer" styleClass="nav-link" />
                <Label text="Accesorios" styleClass="nav-link" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="18">
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/search.png" />
                    </image>
                </ImageView>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/heart.png" />
                    </image>
                </ImageView>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/cart.png" />
                    </image>
                </ImageView>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/menu.png" />
                    </image>
                </ImageView>
            </HBox>
        </HBox>
    </top>

    <!-- ========================================================================= -->
    <!-- CONTENIDO CENTRAL: Panel de Administrador Provisional (Fase 2)           -->
    <!-- ========================================================================= -->
    <center>
        <StackPane alignment="CENTER" style="-fx-background-color: #F8F9FA;">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30" />
            </padding>
            <VBox styleClass="tarjeta-cliente" maxWidth="700" spacing="20" alignment="TOP_CENTER">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Administrador" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblBienvenidaAdmin" text="Admin" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                </HBox>

                <Separator />

                <VBox styleClass="aviso-placeholder" maxWidth="Infinity" spacing="8">
                    <Label text="⚙️ Vista del Panel Administrativo (Fase 2 - En Preparación para Fase 4):" styleClass="aviso-placeholder-texto" />
                    <Label text="El inicio de sesión como Administrador fue exitoso. En la Fase 4 se montarán la tabla completa de Productos con miniaturas, la tabla de Órdenes, el buscador y el acordeón lateral de filtros conforme al diseño de Figma."
                           wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #6c5200;" />
                </VBox>

                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                    <Button text="Cerrar Sesión"
                            styleClass="boton-primario"
                            onAction="#manejarCerrarSesion"
                            prefWidth="220" prefHeight="42" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
