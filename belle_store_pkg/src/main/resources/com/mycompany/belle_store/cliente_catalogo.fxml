<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.belle_store.controladores.ClienteCatalogoController"
            prefWidth="1360.0" prefHeight="820.0"
            stylesheets="@css/estilos.css">

    <!-- ========================================================================= -->
    <!-- CABECERA GLOBAL COMPARTIDA DE CLIENTE                                     -->
    <!-- ========================================================================= -->
    <top>
        <fx:include fx:id="header" source="cliente_header.fxml" />
    </top>

    <!-- ========================================================================= -->
    <!-- ÁREA CENTRAL: BUSCADOR OPCIONAL + CUADRÍCULA DE PRODUCTOS                 -->
    <!-- ========================================================================= -->
    <center>
        <VBox spacing="14" styleClass="fondo-blanco">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24" />
            </padding>

            <!-- Barra de búsqueda reactiva (se muestra/enfoca al pulsar la lupa) -->
            <HBox fx:id="barraBusqueda"
                  styleClass="contenedor-buscador"
                  alignment="CENTER_LEFT"
                  spacing="10"
                  visible="false"
                  managed="false">
                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                    <image>
                        <Image url="@img/search.png" />
                    </image>
                </ImageView>
                <TextField fx:id="campoBusqueda"
                           promptText="Buscar productos por nombre o categoría..."
                           styleClass="campo-buscador"
                           HBox.hgrow="ALWAYS" />
                <Button text="Limpiar"
                        onAction="#limpiarBusqueda"
                        styleClass="boton-secundario" />
            </HBox>

            <!-- Barra de estado, filtro rápido por sexo y retroalimentación breve -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblCategoriaActual" text="Todos los productos" styleClass="titulo-seccion-cliente" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <Button fx:id="btnSexoTodos" text="Todos" userData="TODOS"
                            onAction="#seleccionarSexo" styleClass="boton-filtro-opcion-activo" />
                    <Button fx:id="btnSexoHombre" text="Hombre" userData="HOMBRE"
                            onAction="#seleccionarSexo" styleClass="boton-filtro-opcion" />
                    <Button fx:id="btnSexoMujer" text="Mujer" userData="MUJER"
                            onAction="#seleccionarSexo" styleClass="boton-filtro-opcion" />
                    <Button fx:id="btnSexoUnisex" text="Unisex" userData="UNISEX"
                            onAction="#seleccionarSexo" styleClass="boton-filtro-opcion" />
                </HBox>
            </HBox>

            <Label fx:id="lblMensajeEstado" text="" visible="false" managed="false" />

            <!-- Cuadrícula scrollable de tarjetas de productos + estado vacío -->
            <StackPane VBox.vgrow="ALWAYS">
                <ScrollPane fx:id="scrollCatalogo"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="scroll-catalogo">
                    <content>
                        <FlowPane fx:id="contenedorProductos"
                                  hgap="22"
                                  vgap="24"
                                  styleClass="grid-catalogo">
                            <padding>
                                <Insets top="8" right="8" bottom="18" left="4" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

                <VBox fx:id="estadoVacio"
                      alignment="CENTER"
                      spacing="12"
                      visible="false"
                      managed="false">
                    <Label text="No encontramos productos que coincidan con tu búsqueda o categoría."
                           styleClass="placeholder-tabla" />
                    <Button text="Ver todos los productos"
                            onAction="#mostrarTodosLosProductos"
                            styleClass="boton-secundario" />
                </VBox>
            </StackPane>
        </VBox>
    </center>

    <!-- ========================================================================= -->
    <!-- BARRA LATERAL DERECHA DE CATEGORÍAS (Fiel al frame 42:193 de Figma)       -->
    <!-- ========================================================================= -->
    <right>
        <VBox styleClass="barra-lateral-catalogo" spacing="0">
            <Button fx:id="btnCatTodas"
                    text="Todas"
                    userData="TODAS"
                    onAction="#seleccionarCategoria"
                    maxWidth="Infinity"
                    styleClass="item-categoria-catalogo-activo" />
            <Separator />
            <Button fx:id="btnCatCamisas"
                    text="Camisas"
                    userData="CAMISAS"
                    onAction="#seleccionarCategoria"
                    maxWidth="Infinity"
                    styleClass="item-categoria-catalogo" />
            <Separator />
            <Button fx:id="btnCatPantalones"
                    text="Pantalones"
                    userData="PANTALONES"
                    onAction="#seleccionarCategoria"
                    maxWidth="Infinity"
                    styleClass="item-categoria-catalogo" />
            <Separator />
            <Button fx:id="btnCatAccesorios"
                    text="Accesorios"
                    userData="ACCESORIOS"
                    onAction="#seleccionarCategoria"
                    maxWidth="Infinity"
                    styleClass="item-categoria-catalogo" />
            <Separator />
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </right>
</BorderPane>
