<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.belle_store.controladores.AdminDashboardController"
            prefWidth="1360.0" prefHeight="820.0"
            stylesheets="@css/estilos.css">

    <!-- ========================================================================= -->
    <!-- CABECERA GLOBAL (Header Belle Store)                                      -->
    <!-- ========================================================================= -->
    <top>
        <HBox styleClass="cabecera-global" alignment="CENTER_LEFT" spacing="20">
            <!-- Marca / Logo -->
            <Label text="Belle store" styleClass="logo-belle" />

            <!-- Espaciador flexible -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Enlaces de navegación central -->
            <HBox alignment="CENTER" spacing="25">
                <Label text="Hombre" styleClass="nav-link" />
                <Label text="Mujer" styleClass="nav-link" />
                <Label text="Accesorios" styleClass="nav-link" />
            </HBox>

            <!-- Espaciador flexible -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Iconos de acción a la derecha -->
            <HBox alignment="CENTER_RIGHT" spacing="18">
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/search.png" />
                    </image>
                </ImageView>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/heart.png" />
                    </image>
                </ImageView>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/cart.png" />
                    </image>
                </ImageView>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true" styleClass="icono-cabecera">
                    <image>
                        <Image url="@img/menu.png" />
                    </image>
                </ImageView>
            </HBox>
        </HBox>
    </top>

    <!-- ========================================================================= -->
    <!-- ÁREA CENTRAL DE TRABAJO (TÍTULO, BUSCADOR Y TABLAS)                       -->
    <!-- ========================================================================= -->
    <center>
        <VBox spacing="15" style="-fx-background-color: #FFFFFF;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="25" />
            </padding>

            <!-- Barra Superior / Toolbar de Administración -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <!-- Título Oficial Figma -->
                <Label fx:id="lblTituloVista" text="Administrador" styleClass="titulo-admin" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Barra de Búsqueda Reactiva -->
                <HBox styleClass="contenedor-buscador" alignment="CENTER_LEFT" spacing="8" prefWidth="480">
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                        <image>
                            <Image url="@img/search.png" />
                        </image>
                    </ImageView>
                    <TextField fx:id="campoBusqueda"
                               promptText="Buscar por ID, Nombre, Categoría..."
                               styleClass="campo-buscador"
                               HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Botón Añadir Producto (+ Añadir Producto) -->
                <Button fx:id="btnAnadirProducto"
                        text="+ Añadir Producto"
                        styleClass="boton-anadir-producto"
                        onAction="#abrirModalAnadirProducto" />
            </HBox>

            <!-- Barra de estado y contador de registros -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblContadorRegistros" text="Cargando registros..." styleClass="contador-registros" />
            </HBox>

            <!-- Contenedor de Tablas Apiladas (Productos y Órdenes) -->
            <StackPane fx:id="contenedorTablas" VBox.vgrow="ALWAYS">

                <!-- 1. TABLA DE PRODUCTOS (Figma: Frame Admin Productos 104:517) -->
                <TableView fx:id="tablaProductos" styleClass="tabla-belle">
                    <columns>
                        <TableColumn fx:id="colProdId" text="ID" prefWidth="75.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colProdImagen" text="IMAGEN" prefWidth="95.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colProdNombre" text="NOMBRE" prefWidth="220.0" />
                        <TableColumn fx:id="colProdCategoria" text="CATEGORIA" prefWidth="150.0" />
                        <TableColumn fx:id="colProdStock" text="STOCK" prefWidth="80.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colProdEstado" text="ESTADO" prefWidth="130.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colProdPrecio" text="PRECIO" prefWidth="160.0" styleClass="celda-moneda" />
                        <TableColumn fx:id="colProdAcciones" text="ACCIONES" prefWidth="120.0" styleClass="celda-centrada" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- 2. TABLA DE ÓRDENES (Figma: Frame Admin Ordenes 104:516) -->
                <TableView fx:id="tablaOrdenes" styleClass="tabla-belle" visible="false">
                    <columns>
                        <TableColumn fx:id="colOrdId" text="ID" prefWidth="75.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colOrdCliente" text="CLIENTE" prefWidth="110.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colOrdArticulos" text="ARTÍCULOS" prefWidth="240.0" />
                        <TableColumn fx:id="colOrdTotalArticulos" text="TOTAL ARTÍCULOS" prefWidth="140.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colOrdDireccion" text="DIRECCIÓN" prefWidth="160.0" />
                        <TableColumn fx:id="colOrdEstado" text="ESTADO" prefWidth="130.0" styleClass="celda-centrada" />
                        <TableColumn fx:id="colOrdValorTotal" text="VALOR TOTAL" prefWidth="160.0" styleClass="celda-moneda" />
                        <TableColumn fx:id="colOrdAcciones" text="ACCIONES" prefWidth="120.0" styleClass="celda-centrada" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </StackPane>
        </VBox>
    </center>

    <!-- ========================================================================= -->
    <!-- BARRA LATERAL DERECHA (SIDEBAR: PRODUCTOS, ORDENES, FILTROS, CERRAR SESIÓN) -->
    <!-- ========================================================================= -->
    <right>
        <VBox styleClass="barra-lateral-admin" spacing="12">
            <!-- Enlaces principales de vista -->
            <Button fx:id="btnMenuProductos"
                    text="PRODUCTOS"
                    styleClass="item-menu-admin, item-menu-admin-activo"
                    maxWidth="Infinity"
                    onAction="#mostrarVistaProductos" />

            <Separator style="-fx-padding: 2 0 2 0;" />

            <Button fx:id="btnMenuOrdenes"
                    text="ORDENES"
                    styleClass="item-menu-admin"
                    maxWidth="Infinity"
                    onAction="#mostrarVistaOrdenes" />

            <Separator style="-fx-padding: 2 0 2 0;" />

            <!-- Título de sección de filtros -->
            <Label text="FILTROS" styleClass="titulo-seccion-sidebar" />

            <!-- Contenedores de Filtros según la vista activa -->
            <StackPane alignment="TOP_CENTER">
                <!-- Filtros para la vista de Productos -->
                <VBox fx:id="panelFiltrosProductos" spacing="10">
                    <VBox spacing="6">
                            <!-- Filtro por Categoría -->
                            <TitledPane fx:id="paneFiltroCategoria" text="CATEGORIA" expanded="true">
                                <VBox spacing="4">
                                    <Button fx:id="btnCatTodas" text="• TODAS" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion, boton-filtro-opcion-activo"
                                            onAction="#filtrarCategoriaTodas" />
                                    <Button fx:id="btnCatCamisas" text="• CAMISAS" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarCategoriaCamisas" />
                                    <Button fx:id="btnCatPantalones" text="• PANTALONES" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarCategoriaPantalones" />
                                    <Button fx:id="btnCatAccesorios" text="• ACCESORIOS" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarCategoriaAccesorios" />
                                </VBox>
                            </TitledPane>

                            <!-- Filtro por Estado -->
                            <TitledPane fx:id="paneFiltroEstadoProd" text="ESTADO" expanded="true">
                                <VBox spacing="4">
                                    <Button fx:id="btnEstProdTodos" text="• TODOS" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion, boton-filtro-opcion-activo"
                                            onAction="#filtrarEstadoProdTodos" />
                                    <Button fx:id="btnEstProdDisponible" text="• DISPONIBLE" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarEstadoProdDisponible" />
                                    <Button fx:id="btnEstProdAgotado" text="• AGOTADO" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarEstadoProdAgotado" />
                                </VBox>
                            </TitledPane>
                        </VBox>
                </VBox>

                <!-- Filtros para la vista de Órdenes -->
                <VBox fx:id="panelFiltrosOrdenes" spacing="10" visible="false" managed="false">
                    <VBox spacing="6">
                            <!-- Filtro por Estado de Orden -->
                            <TitledPane fx:id="paneFiltroEstadoOrd" text="ESTADO" expanded="true">
                                <VBox spacing="4">
                                    <Button fx:id="btnEstOrdTodos" text="• TODOS" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion, boton-filtro-opcion-activo"
                                            onAction="#filtrarEstadoOrdTodos" />
                                    <Button fx:id="btnEstOrdNoEntregado" text="• No Entregado" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarEstadoOrdNoEntregado" />
                                    <Button fx:id="btnEstOrdEntregado" text="• Entregado" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarEstadoOrdEntregado" />
                                    <Button fx:id="btnEstOrdPendiente" text="• Pendiente" maxWidth="Infinity"
                                            styleClass="boton-filtro-opcion"
                                            onAction="#filtrarEstadoOrdPendiente" />
                                </VBox>
                            </TitledPane>
                        </VBox>
                </VBox>
            </StackPane>

            <!-- Espacio flexible hacia el botón de cierre -->
            <Region VBox.vgrow="ALWAYS" />

            <Separator style="-fx-padding: 2 0 2 0;" />

            <!-- Botón CERRAR SESIÓN Oficial de Figma -->
            <Button text="CERRAR SESION"
                    styleClass="boton-cerrar-sesion-sidebar"
                    maxWidth="Infinity"
                    onAction="#manejarCerrarSesion" />
        </VBox>
    </right>

</BorderPane>
